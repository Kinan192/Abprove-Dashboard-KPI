APP_NAME="KPI Kinerja"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_TIMEZONE=UTC
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=kpi_kinerja_dev
DB_USERNAME=root
DB_PASSWORD=
SESSION_DRIVER=file
SESSION_LIFETIME=30
SESSION_ENCRYPT=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_SECURE_COOKIE=false
CACHE_STORE=file
# sync: email pengingat dikirim langsung saat Admin menekan Kirim (lambat untuk banyak penerima).
# database: jalankan `php artisan queue:work` agar email dikirim di latar belakang.
QUEUE_CONNECTION=sync
# Email pengingat (SMTP). MAIL_MAILER=log hanya menulis ke storage/logs.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"
BCRYPT_ROUNDS=12
LOG_CHANNEL=stack
LOG_STACK=single
APP_MAINTENANCE_DRIVER=file
# Gunakan HTTPS dan SESSION_SECURE_COOKIE=true pada deployment.
# Database baru untuk migrations; jangan gunakan database yang sudah di-import SQL lama.
BETTER_AUTH_SECRET=
BETTER_AUTH_PORT=3031
BETTER_AUTH_INTERNAL_URL=http://127.0.0.1:3031
BETTER_AUTH_TRUSTED_ORIGINS=
