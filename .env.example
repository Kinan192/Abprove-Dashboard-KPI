APP_NAME="KPI Kinerja"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_TIMEZONE=UTC
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=kpi_kinerja_dev
DB_USERNAME=root
DB_PASSWORD=
SESSION_DRIVER=file
SESSION_LIFETIME=30
SESSION_ENCRYPT=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_SECURE_COOKIE=false
CACHE_STORE=file
QUEUE_CONNECTION=sync
BCRYPT_ROUNDS=12
LOG_CHANNEL=stack
LOG_STACK=single
APP_MAINTENANCE_DRIVER=file
# Gunakan HTTPS dan SESSION_SECURE_COOKIE=true pada deployment.
# Database baru untuk migrations; jangan gunakan database yang sudah di-import SQL lama.
# Opsional sebelum db:seed pertama: KPI_DEMO_PASSWORD (12+ karakter, huruf dan angka).
# Jika tidak diisi, password contoh dibuat acak dan disimpan pada storage/app/private/.
BETTER_AUTH_SECRET=
BETTER_AUTH_PORT=3031
BETTER_AUTH_INTERNAL_URL=http://127.0.0.1:3031
BETTER_AUTH_TRUSTED_ORIGINS=
